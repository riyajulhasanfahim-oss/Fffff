rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // STRICT ADMIN AUTHORIZATION:
    // Only authenticated tokens with custom claim admin == true OR verified matching the two approved emails
    function isUserAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        (
          request.auth.token.email in ['riyajulhasanfahim@gmail.com', 'frofficialbd1@gmail.com'] &&
          (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'password' || request.auth.token.firebase.sign_in_provider == 'google.com')
        )
      );
    }

    function isUserActive() {
      return isSignedIn() && (
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != 'inactive' &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != 'suspended'
        )
      );
    }

    function isUserVendor() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Vendor' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'vendor' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.hasActiveVendor == true
      );
    }

    function isUserReseller() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Reseller' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'reseller' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountType == 'reseller' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.hasActiveReseller == true
      );
    }

    // User profiles - Users can NEVER grant themselves or change role to Admin
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        (request.auth.uid == userId && request.resource.data.role != 'Admin' && request.resource.data.role != 'admin') ||
        isUserAdmin()
      );
      allow update: if isUserAdmin() || (
        isSignedIn() &&
        request.auth.uid == userId &&
        isUserActive() &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'role']) || 
         (request.resource.data.status == resource.data.status && request.resource.data.role == resource.data.role))
      );
      allow delete: if isUserAdmin();

      match /followed_stores/{storeId} {
        allow read, write: if isSignedIn() && (request.auth.uid == userId || isUserAdmin());
      }
    }

    // User carts & wishlists
    match /carts/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /wishlists/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Main Orders Collection
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isUserAdmin();
    }

    // Vendor-specific order partition
    match /vendor_orders/{vOrderId} {
      allow read: if true;
      allow create: if true;
      allow update: if isSignedIn() || true;
      allow delete: if isUserAdmin() || isSignedIn();
    }

    // Courier Link Reviews (Vendor submits -> Admin reviews & approves/rejects)
    match /courier_link_reviews/{reviewId} {
      allow read: if true;
      allow create, update: if isSignedIn() || true;
      allow delete: if isUserAdmin() || isSignedIn();
    }

    // Vendor wallets and transactions
    match /vendor_wallet/{vendorId} {
      allow read: if isUserAdmin() || isSignedIn();
      allow create, update: if isUserAdmin() || isSignedIn();
      allow delete: if isUserAdmin();
    }

    match /vendor_wallet_transactions/{docId} {
      allow read, write: if isUserAdmin() || isSignedIn();
      match /{document=**} {
        allow read, write: if isUserAdmin() || isSignedIn();
      }
    }

    match /vendor_wallet_deposits/{depositId} {
      allow read, write: if isUserAdmin() || isSignedIn();
    }

    match /reseller_profit_locks/{lockId} {
      allow read, write: if isUserAdmin() || isSignedIn();
    }

    match /financial_idempotency/{idempId} {
      allow read, write: if isUserAdmin() || isSignedIn();
    }

    match /reseller_return_requests/{reqId} {
      allow read, write: if isUserAdmin() || isSignedIn();
    }

    match /admin_notifications/{notifId} {
      allow read: if isUserAdmin();
      allow write: if true;
    }

    match /vendor_warnings/{docId} {
      allow read, write: if isUserAdmin() || isSignedIn();
      match /{document=**} {
        allow read, write: if isUserAdmin() || isSignedIn();
      }
    }

    match /platform_fees/{feeId} {
      allow read, write: if isUserAdmin() || isSignedIn();
    }

    match /wallet_transactions/{transactionId} {
      allow read: if isUserAdmin() || (isSignedIn() && resource.data.vendorId == request.auth.uid);
      allow write, create: if isUserAdmin() || isSignedIn();
    }

    // Disputes collection
    match /disputes/{disputeId} {
      allow read: if isUserAdmin() || 
        (isSignedIn() && (
          resource.data.customerId == request.auth.uid || 
          resource.data.vendorId == request.auth.uid ||
          resource.data.userId == request.auth.uid
        ));
      allow create: if isSignedIn();
      allow update: if isUserAdmin() || 
        (isSignedIn() && (
          resource.data.customerId == request.auth.uid || 
          resource.data.vendorId == request.auth.uid
        ));
      allow delete: if isUserAdmin();
    }

    // Vendor applications & stores
    match /vendor_applications/{applicationId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.userId || isUserAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (request.auth.uid == resource.data.userId || isUserAdmin());
    }

    match /vendors/{vendorId} {
      allow read: if true;
      allow write: if isUserAdmin() || (isSignedIn() && request.auth.uid == vendorId) || (
        isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersCount', 'followers', 'updatedAt'])
      );

      match /store/{storeId} {
        allow read: if true;
        allow write: if isUserAdmin() || (isSignedIn() && request.auth.uid == vendorId);
      }

      match /{document=**} {
        allow read: if true;
        allow write: if isUserAdmin() || (isSignedIn() && request.auth.uid == vendorId);
      }
    }

    match /vendor_profiles/{vendorId} {
      allow read: if true;
      allow write: if isUserAdmin() || (isSignedIn() && request.auth.uid == vendorId) || (
        isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersCount', 'followers', 'updatedAt'])
      );

      match /{document=**} {
        allow read: if true;
        allow write: if isUserAdmin() || (isSignedIn() && request.auth.uid == vendorId);
      }
    }

    match /vendor_settings/{vendorId} {
      allow read: if true;
      allow write: if isUserAdmin() || (isSignedIn() && request.auth.uid == vendorId);
    }

    match /vendor_themes/{vendorId} {
      allow read: if true;
      allow write: if isUserAdmin() || (isSignedIn() && request.auth.uid == vendorId);
    }

    // Stores collection (Vendor and Reseller stores)
    match /stores/{storeId} {
      allow read: if true;
      allow write: if isUserAdmin() || (isSignedIn() && request.auth.uid == storeId) || (
        isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersCount', 'followers', 'updatedAt'])
      );
    }

    // Store Slugs mapping for fast O(1) clean Store URL lookup
    match /store_slugs/{slug} {
      allow read: if true;
      allow write: if isSignedIn() || isUserAdmin();
    }

    // Store Followers collection
    match /store_followers/{followerDocId} {
      allow read: if true;
      allow create, update: if isSignedIn() && (request.auth.uid == request.resource.data.userId || followerDocId.matches('.*_' + request.auth.uid) || isUserAdmin());
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.userId || followerDocId.matches('.*_' + request.auth.uid) || isUserAdmin());
    }

    match /vendor_statistics/{vendorId} {
      allow read: if isUserAdmin() || (isSignedIn() && request.auth.uid == vendorId);
      allow write: if isUserAdmin() || (isSignedIn() && request.auth.uid == vendorId);
    }

    // Products & catalog
    match /products/{productId} {
      allow read: if true;
      allow create: if isUserAdmin() || (isSignedIn() && (request.resource.data.vendorId == request.auth.uid || request.resource.data.resellerId == request.auth.uid));
      allow update, delete: if isUserAdmin() || (isSignedIn() && (resource.data.vendorId == request.auth.uid || resource.data.resellerId == request.auth.uid));
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isUserAdmin();
    }

    match /product_categories/{categoryId} {
      allow read: if true;
      allow write: if isUserAdmin();
    }

    match /brands/{brandId} {
      allow read: if true;
      allow write: if isUserAdmin();
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isUserAdmin();
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isUserAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isUserAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /vendor_reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isUserAdmin();
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read, write: if true;
      match /{document=**} {
        allow read, write: if true;
      }
    }

    match /vendor_notifications/{notificationId} {
      allow read, write: if true;
      match /{document=**} {
        allow read, write: if true;
      }
    }

    // Reseller and MLM ecosystem
    match /reseller_applications/{applicationId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.userId || isUserAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (request.auth.uid == resource.data.userId || isUserAdmin());
    }

    match /resellers/{resellerId} {
      allow read: if true;
      allow create: if isSignedIn() && request.auth.uid == resellerId;
      allow update, delete: if isUserAdmin() || (isSignedIn() && request.auth.uid == resellerId);
    }

    // Reseller Wallet Structure
    match /reseller_wallet/{resellerId} {
      allow read: if isUserAdmin() || (isUserReseller() && request.auth.uid == resellerId);
      allow create: if isUserAdmin() || (
        isUserReseller() && 
        request.auth.uid == resellerId &&
        (request.resource.data.availableBalance == 0 || !('availableBalance' in request.resource.data)) &&
        (request.resource.data.lockedBalance == 0 || !('lockedBalance' in request.resource.data)) &&
        (request.resource.data.totalBalance == 0 || !('totalBalance' in request.resource.data)) &&
        (request.resource.data.pendingProfit == 0 || !('pendingProfit' in request.resource.data)) &&
        (request.resource.data.releasedProfit == 0 || !('releasedProfit' in request.resource.data)) &&
        (request.resource.data.cancelledProfit == 0 || !('cancelledProfit' in request.resource.data))
      );
      allow update: if isUserAdmin();
      allow delete: if isUserAdmin();
    }

    // Reseller Wallet Transaction Ledger
    match /reseller_wallet_transactions/{transactionId} {
      allow read: if isUserAdmin() || (isUserReseller() && resource.data.resellerId == request.auth.uid);
      allow create, update, delete: if isUserAdmin();
    }

    // Reseller Custom Products & Selling Price System
    match /reseller_products/{docId} {
      allow read: if isUserAdmin() || (isUserReseller() && resource.data.resellerId == request.auth.uid);
      allow create: if isUserAdmin() || (
        isUserReseller() && 
        request.auth.uid == request.resource.data.resellerId &&
        request.resource.data.resellerSellingPrice >= request.resource.data.vendorPrice &&
        request.resource.data.resellerProfit == (request.resource.data.resellerSellingPrice - request.resource.data.vendorPrice)
      );
      allow update: if isUserAdmin() || (
        isUserReseller() && 
        request.auth.uid == resource.data.resellerId &&
        request.auth.uid == request.resource.data.resellerId &&
        request.resource.data.vendorPrice == resource.data.vendorPrice &&
        request.resource.data.resellerSellingPrice >= resource.data.vendorPrice &&
        request.resource.data.resellerProfit == (request.resource.data.resellerSellingPrice - resource.data.vendorPrice)
      );
      allow delete: if isUserAdmin() || (isUserReseller() && resource.data.resellerId == request.auth.uid);
    }

    match /wallets/{walletId} {
      allow read, write: if isUserAdmin() || (isSignedIn() && request.auth.uid == walletId);
    }

    match /user_wallet/{walletId} {
      allow read, write: if isUserAdmin() || (isSignedIn() && request.auth.uid == walletId);
    }

    // Reseller orders partition
    match /reseller_orders/{roId} {
      allow read: if true;
      allow create: if true;
      allow update: if isUserAdmin() || isSignedIn();
      allow delete: if isUserAdmin() || isSignedIn();
    }

    match /withdrawals/{withdrawalId} {
      allow read: if isUserAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isUserAdmin();
    }

    match /withdraw_requests/{withdrawId} {
      allow read: if isUserAdmin() || (isSignedIn() && (resource.data.vendorId == request.auth.uid || resource.data.userId == request.auth.uid));
      allow create: if isSignedIn();
      allow update, delete: if isUserAdmin();
    }

    match /referral_tracking/{trackingId} {
      allow read: if isUserAdmin() || (isSignedIn() && resource.data.resellerId == request.auth.uid);
      allow create: if true;
    }

    match /resellerTracking/{docId} {
      allow read, write: if isUserAdmin() || (isSignedIn() && (resource == null || resource.data.resellerId == request.auth.uid || request.resource.data.resellerId == request.auth.uid));
    }

    match /reseller_transactions/{transactionId} {
      allow read: if isUserAdmin() || (isSignedIn() && resource.data.resellerId == request.auth.uid);
      allow create, write: if isUserAdmin() || isSignedIn();
    }

    match /chats/{document=**} {
      allow read, write: if isSignedIn();
    }

    match /payments/{paymentId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isUserAdmin();
    }

    match /system_settings/{settingId} {
      allow read: if true;
      allow write: if isUserAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isUserAdmin();
    }

    match /couriers/{courierId} {
      allow read: if true;
      allow write: if isUserAdmin();
    }

    match /ranks/{rankId} {
      allow read: if true;
      allow write: if isUserAdmin();
    }

    match /commission_rules/{ruleId} {
      allow read: if true;
      allow write: if isUserAdmin();
    }

    match /bonus_rules/{ruleId} {
      allow read: if true;
      allow write: if isUserAdmin();
    }

    match /bonus_transactions/{txId} {
      allow read: if isUserAdmin() || (isSignedIn() && resource.data.resellerId == request.auth.uid);
      allow write: if isUserAdmin() || isSignedIn();
    }

    match /commission_transactions/{txId} {
      allow read: if isUserAdmin() || (isSignedIn() && resource.data.resellerId == request.auth.uid);
      allow write: if isUserAdmin() || isSignedIn();
    }

    match /user_referral_transactions/{txId} {
      allow read: if isUserAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if isUserAdmin() || isSignedIn();
    }

    match /mlm_members/{memberId} {
      allow read: if isSignedIn();
      allow write: if isUserAdmin() || (isSignedIn() && (request.auth.uid == memberId || request.resource.data.userId == request.auth.uid));
    }

    match /referral_codes/{codeId} {
      allow read: if true;
      allow write: if isUserAdmin() || isSignedIn();
    }

    match /referral_rewards_log/{logId} {
      allow read, write: if isSignedIn();
    }

    match /referral_credits/{creditId} {
      allow read, write: if isSignedIn();
    }

    match /promo_codes/{codeId} {
      allow read: if true;
      allow write: if isUserAdmin() || (isSignedIn() && (resource.data.resellerId == request.auth.uid || request.resource.data.resellerId == request.auth.uid));
    }

    match /verified_seller_requests/{requestId} {
      allow read: if isUserAdmin() || (isSignedIn() && (resource.data.vendorId == request.auth.uid || resource.data.userId == request.auth.uid));
      allow create: if isSignedIn();
      allow update, delete: if isUserAdmin();
    }

    match /inventory_logs/{logId} {
      allow read, write: if true;
    }

    match /order_items/{itemId} {
      allow read, write: if true;
    }

    match /orderItems/{itemId} {
      allow read, write: if true;
    }

    match /order_status_logs/{logId} {
      allow read, write: if true;
    }

    match /orderNotes/{noteId} {
      allow read, write: if true;
    }

    match /shippingAddresses/{addressId} {
      allow read, write: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid || isUserAdmin());
    }

    match /supportTickets/{ticketId} {
      allow read: if isUserAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn();
      allow update: if isUserAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isUserAdmin();
    }

    match /storage_accounts/{accountId} {
      allow read, write: if isUserAdmin();
    }

    match /storage_files/{fileId} {
      allow read: if true;
      allow write: if isUserAdmin();
    }
  }
}
