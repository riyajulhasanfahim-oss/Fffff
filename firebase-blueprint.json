{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile data",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "photo": { "type": "string" },
        "role": { "type": "string" },
        "language": { "type": "string" },
        "wallet": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["uid", "name", "email", "role", "createdAt"]
    },
    "Product": {
      "title": "Product",
      "description": "E-commerce product item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "discount": { "type": "number" },
        "category": { "type": "string" },
        "categorySlug": { "type": "string" },
        "brand": { "type": "string" },
        "image": { "type": "string" },
        "images": { "type": "array" },
        "description": { "type": "string" },
        "rating": { "type": "number" },
        "reviews": { "type": "number" },
        "inStock": { "type": "boolean" },
        "stockCount": { "type": "number" },
        "vendorId": { "type": "string" }
      },
      "required": ["id", "name", "price", "category", "image"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order",
      "type": "object",
      "properties": {
        "orderId": { "type": "string" },
        "userId": { "type": "string" },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["orderId", "userId", "items", "total", "status", "createdAt"]
    },
    "PaymentVerification": {
      "title": "Payment Verification",
      "description": "Custom payment verification record for manual or SMS-assisted transaction verification",
      "type": "object",
      "properties": {
        "paymentId": { "type": "string" },
        "invoiceId": { "type": "string" },
        "userId": { "type": "string" },
        "userType": { "type": "string", "enum": ["customer", "reseller", "vendor"] },
        "paymentMethod": { "type": "string", "enum": ["bkash", "nagad", "rocket", "upay"] },
        "expectedAmount": { "type": "number" },
        "transactionId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "verified", "rejected"] },
        "senderNumber": { "type": "string" },
        "receivedAmount": { "type": "number" },
        "verifiedAt": { "type": "number" },
        "createdAt": { "type": "number" },
        "expiresAt": { "type": "string", "format": "date-time", "description": "Firestore Timestamp when this payment document expires (10 days after creation) for automatic deletion via Firestore TTL" },
        "rejectionReason": { "type": "string" }
      },
      "required": [
        "paymentId",
        "invoiceId",
        "userId",
        "userType",
        "paymentMethod",
        "expectedAmount",
        "transactionId",
        "status",
        "createdAt"
      ]
    },
    "ResellerWallet": {
      "title": "Reseller Wallet",
      "description": "Reseller financial wallet balances and profit tracking",
      "type": "object",
      "properties": {
        "resellerId": { "type": "string" },
        "availableBalance": { "type": "number" },
        "lockedBalance": { "type": "number" },
        "totalBalance": { "type": "number" },
        "pendingProfit": { "type": "number" },
        "releasedProfit": { "type": "number" },
        "cancelledProfit": { "type": "number" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": [
        "resellerId",
        "availableBalance",
        "lockedBalance",
        "totalBalance",
        "pendingProfit",
        "releasedProfit",
        "cancelledProfit",
        "createdAt",
        "updatedAt"
      ]
    },
    "ResellerWalletTransaction": {
      "title": "Reseller Wallet Transaction",
      "description": "Immutable ledger record of reseller wallet balance operations",
      "type": "object",
      "properties": {
        "transactionId": { "type": "string" },
        "resellerId": { "type": "string" },
        "orderId": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string" },
        "status": { "type": "string" },
        "balanceBefore": { "type": "object" },
        "balanceAfter": { "type": "object" },
        "description": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": [
        "transactionId",
        "resellerId",
        "orderId",
        "amount",
        "type",
        "status",
        "balanceBefore",
        "balanceAfter",
        "description",
        "createdAt",
        "updatedAt"
      ]
    },
    "ResellerProduct": {
      "title": "Reseller Product",
      "description": "Reseller customized selling price and calculated profit for vendor products",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "resellerId": { "type": "string" },
        "productId": { "type": "string" },
        "vendorId": { "type": "string" },
        "productName": { "type": "string" },
        "vendorPrice": { "type": "number" },
        "resellerSellingPrice": { "type": "number" },
        "resellerProfit": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": [
        "id",
        "resellerId",
        "productId",
        "vendorPrice",
        "resellerSellingPrice",
        "resellerProfit",
        "createdAt",
        "updatedAt"
      ]
    },
    "ResellerOrder": {
      "title": "Reseller Order",
      "description": "Reseller customer orders, price snapshots, and pending profit records",
      "type": "object",
      "properties": {
        "orderId": { "type": "string" },
        "resellerId": { "type": "string" },
        "vendorId": { "type": "string" },
        "productId": { "type": "string" },
        "quantity": { "type": "number" },
        "vendorPrice": { "type": "number" },
        "resellerSellingPrice": { "type": "number" },
        "customerPaidAmount": { "type": "number" },
        "resellerProfit": { "type": "number" },
        "profitStatus": { "type": "string", "enum": ["PENDING", "CANCELLED", "RELEASED"] },
        "orderStatus": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": [
        "orderId",
        "resellerId",
        "vendorId",
        "productId",
        "quantity",
        "vendorPrice",
        "resellerSellingPrice",
        "customerPaidAmount",
        "resellerProfit",
        "profitStatus",
        "orderStatus",
        "paymentMethod",
        "createdAt",
        "updatedAt"
      ]
    },
    "Shareholder": {
      "title": "Shareholder",
      "description": "Verified company equity ownership profile and portfolio",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "shareholderName": { "type": "string" },
        "activeSharesPercent": { "type": "number" },
        "portfolioValue": { "type": "number" },
        "status": { "type": "string" },
        "lastVerifiedAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["userId", "shareholderName", "activeSharesPercent", "status", "updatedAt"]
    },
    "SharePayment": {
      "title": "Share Payment",
      "description": "Shareholder investment application and payment verification record",
      "type": "object",
      "properties": {
        "applicationId": { "type": "string" },
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "applicantName": { "type": "string" },
        "guardianName": { "type": "string" },
        "address": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "sharePercent": { "type": "number" },
        "sharePrice": { "type": "number" },
        "shareUnits": { "type": "number" },
        "totalAmount": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "transactionId": { "type": "string" },
        "payerMobile": { "type": "string" },
        "paymentStatus": { "type": "string" },
        "status": { "type": "string" },
        "isShareholderActive": { "type": "boolean" },
        "isOfficialCertificateIssued": { "type": "boolean" },
        "verifiedAt": { "type": "number" },
        "verifiedBy": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["applicationId", "userId", "sharePercent", "totalAmount", "paymentMethod", "transactionId", "status", "createdAt"]
    },
    "ShareCertificate": {
      "title": "Share Certificate",
      "description": "Official corporate shareholder certificate record",
      "type": "object",
      "properties": {
        "certificateNumber": { "type": "string" },
        "shareholderId": { "type": "string" },
        "userId": { "type": "string" },
        "fullName": { "type": "string" },
        "approvedSharePercentage": { "type": "number" },
        "totalAmountPaid": { "type": "number" },
        "issueDate": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["certificateNumber", "shareholderId", "userId", "approvedSharePercentage", "totalAmountPaid", "issueDate"]
    },
    "ShareholderWithdrawal": {
      "title": "Shareholder Withdrawal",
      "description": "Shareholder benefit withdrawal request and payout record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "amount": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "accountNumber": { "type": "string" },
        "status": { "type": "string" },
        "requestedAt": { "type": "number" },
        "processedAt": { "type": "number" }
      },
      "required": ["id", "userId", "amount", "paymentMethod", "accountNumber", "status", "requestedAt"]
    }
  },
