{
  "rules": {
    "products": {
      ".read": true,
      ".write": "auth != null"
    },
    "categories": {
      ".read": true,
      ".write": "auth != null"
    },
    "stores": {
      ".read": true,
      ".write": "auth != null"
    },
    "vendors": {
      ".read": true,
      ".write": "auth != null"
    },
    "vendor_profiles": {
      ".read": true,
      ".write": "auth != null"
    },
    "vendor_themes": {
      ".read": true,
      ".write": "auth != null"
    },
    "vendor_reviews": {
      ".read": true,
      ".write": "auth != null"
    },
    "deleted_vendors": {
      ".read": true,
      ".write": "auth != null"
    },
    "brands": {
      ".read": true,
      ".write": "auth != null"
    },
    "banners": {
      ".read": true,
      ".write": "auth != null"
    },
    "sliders": {
      ".read": true,
      ".write": "auth != null"
    },
    "coupons": {
      ".read": true,
      ".write": "auth != null"
    },
    "flashSales": {
      ".read": true,
      ".write": "auth != null"
    },
    "notices": {
      ".read": true,
      ".write": "auth != null"
    },
    "reviews": {
      ".read": true,
      ".write": "auth != null"
    },
    "settings": {
      ".read": true,
      ".write": "auth != null"
    },
    "config": {
      ".read": true,
      ".write": "auth != null"
    },
    "ranks": {
      ".read": true,
      ".write": "auth != null"
    },
    "commission_rules": {
      ".read": true,
      ".write": "auth != null"
    },
    "bonus_rules": {
      ".read": true,
      ".write": "auth != null"
    },
    "resellers": {
      ".read": true,
      ".write": "auth != null"
    },
    "users": {
      "$userId": {
        ".read": "auth != null && (auth.uid === $userId || root.child('users/' + auth.uid + '/role').val() === 'admin')",
        ".write": "auth != null && (auth.uid === $userId || root.child('users/' + auth.uid + '/role').val() === 'admin')"
      }
    },
    "orders": {
      ".read": "auth != null",
      ".write": true
    },
    "payments": {
      ".read": true,
      ".write": true
    },
    "reseller_wallet": {
      "$resellerId": {
        ".read": "auth != null && (auth.uid === $resellerId || root.child('users/' + auth.uid + '/role').val() === 'admin')",
        ".write": "auth != null && root.child('users/' + auth.uid + '/role').val() === 'admin'"
      }
    },
    "vendor_wallet": {
      "$vendorId": {
        ".read": "auth != null && (auth.uid === $vendorId || root.child('users/' + auth.uid + '/role').val() === 'admin')",
        ".write": "auth != null && root.child('users/' + auth.uid + '/role').val() === 'admin'"
      }
    },
    "wallets": {
      "$userId": {
        ".read": "auth != null && (auth.uid === $userId || root.child('users/' + auth.uid + '/role').val() === 'admin')",
        ".write": "auth != null && root.child('users/' + auth.uid + '/role').val() === 'admin'"
      }
    },
    "reseller_orders": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["resellerId", "vendorId", "orderId", "profitStatus", "orderStatus", "createdAt"]
    },
    "reseller_profit_locks": {
      ".indexOn": ["orderId", "vendorId", "resellerId", "status", "createdAt"]
    },
    "reseller_profit_releases": {
      ".indexOn": ["orderId", "resellerId", "vendorId", "createdAt"]
    },
    "reseller_profit_reviews": {
      ".indexOn": ["orderId", "resellerId", "reviewStatus", "submittedAt"]
    },
    "reseller_return_requests": {
      ".indexOn": ["orderId", "vendorId", "returnStatus", "createdAt"]
    },
    "reseller_profit_reversals": {
      ".indexOn": ["orderId", "resellerId", "vendorId", "status", "createdAt"]
    },
    "reseller_financial_idempotency": {
      ".indexOn": ["orderId", "transactionType", "createdAt"]
    },
    "order_status_logs": {
      ".indexOn": ["orderId", "timestamp"]
    },
    "courier_link_reviews": {
      "$orderId": {
        ".validate": "!root.child('reseller_orders/' + $orderId).exists() || root.child('reseller_orders/' + $orderId + '/profitStatus').val() === 'LOCKED' || root.child('reseller_orders/' + $orderId + '/profitStatus').val() === 'RELEASED'"
      },
      ".indexOn": ["orderId", "vendorId", "status", "submittedAt"]
    }
  }
}
