{
  "rules": {
    "products": {
      ".read": true,
      ".write": "auth != null"
    },
    "categories": {
      ".read": true,
      ".write": "auth != null"
    },
    "stores": {
      ".read": true,
      ".write": "auth != null"
    },
    "vendors": {
      ".read": true,
      ".write": "auth != null"
    },
    "vendor_profiles": {
      ".read": true,
      ".write": "auth != null"
    },
    "vendor_themes": {
      ".read": true,
      ".write": "auth != null"
    },
    "vendor_reviews": {
      ".read": true,
      ".write": "auth != null"
    },
    "deleted_vendors": {
      ".read": true,
      ".write": "auth != null"
    },
    "brands": {
      ".read": true,
      ".write": "auth != null"
    },
    "banners": {
      ".read": true,
      ".write": "auth != null"
    },
    "sliders": {
      ".read": true,
      ".write": "auth != null"
    },
    "coupons": {
      ".read": true,
      ".write": "auth != null"
    },
    "flashSales": {
      ".read": true,
      ".write": "auth != null"
    },
    "notices": {
      ".read": true,
      ".write": "auth != null"
    },
    "reviews": {
      ".read": true,
      ".write": "auth != null"
    },
    "settings": {
      ".read": true,
      ".write": "auth != null"
    },
    "config": {
      ".read": true,
      ".write": "auth != null"
    },
    "ranks": {
      ".read": true,
      ".write": "auth != null"
    },
    "commission_rules": {
      ".read": true,
      ".write": "auth != null"
    },
    "bonus_rules": {
      ".read": true,
      ".write": "auth != null"
    },
    "resellers": {
      ".read": true,
      ".write": "auth != null"
    },
    "users": {
      "$userId": {
        ".read": "auth != null && (auth.uid === $userId || root.child('users/' + auth.uid + '/role').val() === 'admin')",
        ".write": "auth != null && (auth.uid === $userId || root.child('users/' + auth.uid + '/role').val() === 'admin')"
      }
    },
    "orders": {
      ".read": "auth != null",
      ".write": true
    },
    "payments": {
      ".read": true,
      ".write": true
    },
    "reseller_wallet": {
      "$resellerId": {
        ".read": "auth != null && (auth.uid === $resellerId || root.child('users/' + auth.uid + '/role').val() === 'admin')",
        ".write": "auth != null && root.child('users/' + auth.uid + '/role').val() === 'admin'"
      }
    },
    "vendor_wallet": {
      "$vendorId": {
        ".read": "auth != null && (auth.uid === $vendorId || root.child('users/' + auth.uid + '/role').val() === 'admin' || root.child('users/' + auth.uid + '/role').val() === 'Admin')",
        ".write": "auth != null && (auth.uid === $vendorId || root.child('users/' + auth.uid + '/role').val() === 'admin' || root.child('users/' + auth.uid + '/role').val() === 'Admin')"
      }
    },
    "wallets": {
      "$userId": {
        ".read": "auth != null && (auth.uid === $userId || root.child('users/' + auth.uid + '/role').val() === 'admin' || root.child('users/' + auth.uid + '/role').val() === 'Admin')",
        ".write": "auth != null && (auth.uid === $userId || root.child('users/' + auth.uid + '/role').val() === 'admin' || root.child('users/' + auth.uid + '/role').val() === 'Admin')"
      }
    },
    "reseller_orders": {
      ".read": "auth != null",
      ".write": true,
      ".indexOn": ["resellerId", "vendorId", "orderId", "profitStatus", "orderStatus", "createdAt"]
    },
    "vendor_orders": {
      ".read": "auth != null",
      ".write": true,
      ".indexOn": ["vendorId", "userId", "orderId", "mainOrderId", "status", "vendorStatus", "createdAt"]
    },
    "reseller_profit_locks": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["orderId", "vendorId", "resellerId", "status", "createdAt"]
    },
    "reseller_profit_releases": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["orderId", "resellerId", "vendorId", "createdAt"]
    },
    "reseller_profit_reviews": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["orderId", "resellerId", "reviewStatus", "submittedAt"]
    },
    "reseller_return_requests": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["orderId", "vendorId", "returnStatus", "createdAt"]
    },
    "reseller_profit_reversals": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["orderId", "resellerId", "vendorId", "status", "createdAt"]
    },
    "reseller_financial_idempotency": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["orderId", "transactionType", "createdAt"]
    },
    "order_status_logs": {
      ".read": "auth != null",
      ".write": true,
      ".indexOn": ["orderId", "timestamp"]
    },
    "order_courier_logs": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["orderId", "timestamp"]
    },
    "admin_notifications": {
      ".read": "auth != null",
      ".write": true
    },
    "vendor_notifications": {
      ".read": "auth != null",
      ".write": true
    },
    "vendor_wallet_transactions": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "courier_link_reviews": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["orderId", "vendorId", "status", "submittedAt"]
    }
  }
}
