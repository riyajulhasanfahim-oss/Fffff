{
  "rules": {
    "products": {
      ".read": true,
      ".write": "auth != null"
    },
    "categories": {
      ".read": true,
      ".write": "auth != null && auth.token.admin === true"
    },
    "stores": {
      ".read": true,
      ".write": "auth != null"
    },
    "vendors": {
      ".read": true,
      ".write": "auth != null"
    },
    "vendor_profiles": {
      ".read": true,
      ".write": "auth != null"
    },
    "vendor_themes": {
      ".read": true,
      ".write": "auth != null"
    },
    "vendor_reviews": {
      ".read": true,
      ".write": "auth != null"
    },
    "deleted_vendors": {
      ".read": true,
      ".write": "auth != null && auth.token.admin === true"
    },
    "brands": {
      ".read": true,
      ".write": "auth != null && auth.token.admin === true"
    },
    "banners": {
      ".read": true,
      ".write": "auth != null && auth.token.admin === true"
    },
    "sliders": {
      ".read": true,
      ".write": "auth != null && auth.token.admin === true"
    },
    "coupons": {
      ".read": true,
      ".write": "auth != null && auth.token.admin === true"
    },
    "flashSales": {
      ".read": true,
      ".write": "auth != null && auth.token.admin === true"
    },
    "notices": {
      ".read": true,
      ".write": "auth != null && auth.token.admin === true"
    },
    "reviews": {
      ".read": true,
      ".write": "auth != null"
    },
    "chats": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["customerId", "vendorId", "storeId", "lastMessageTime"]
    },
    "settings": {
      ".read": true,
      ".write": "auth != null && auth.token.admin === true"
    },
    "config": {
      ".read": true,
      ".write": "auth != null && auth.token.admin === true"
    },
    "ranks": {
      ".read": true,
      ".write": "auth != null && auth.token.admin === true"
    },
    "commission_rules": {
      ".read": true,
      ".write": "auth != null && auth.token.admin === true"
    },
    "bonus_rules": {
      ".read": true,
      ".write": "auth != null && auth.token.admin === true"
    },
    "resellers": {
      ".read": true,
      ".write": "auth != null"
    },
    "users": {
      "$userId": {
        ".read": "auth != null && (auth.uid === $userId || auth.token.admin === true)",
        ".write": "auth != null && (auth.uid === $userId || auth.token.admin === true)",
        "role": {
          ".validate": "newData.val() !== 'Admin' && newData.val() !== 'admin' || auth.token.admin === true"
        }
      }
    },
    "orders": {
      ".read": "auth != null",
      ".write": true
    },
    "payments": {
      ".read": true,
      ".write": true
    },
    "reseller_wallet": {
      "$resellerId": {
        ".read": "auth != null && (auth.uid === $resellerId || auth.token.admin === true)",
        ".write": "auth != null && auth.token.admin === true"
      }
    },
    "vendor_wallet": {
      "$vendorId": {
        ".read": "auth != null && (auth.uid === $vendorId || auth.token.admin === true)",
        ".write": "auth != null && (auth.uid === $vendorId || auth.token.admin === true)"
      }
    },
    "wallets": {
      "$userId": {
        ".read": "auth != null && (auth.uid === $userId || auth.token.admin === true)",
        ".write": "auth != null && (auth.uid === $userId || auth.token.admin === true)"
      }
    },
    "reseller_orders": {
      ".read": "auth != null",
      ".write": true,
      ".indexOn": ["resellerId", "vendorId", "orderId", "profitStatus", "orderStatus", "createdAt"]
    },
    "vendor_orders": {
      ".read": "auth != null",
      ".write": true,
      ".indexOn": ["vendorId", "userId", "orderId", "mainOrderId", "status", "vendorStatus", "createdAt"]
    },
    "reseller_profit_locks": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["orderId", "vendorId", "resellerId", "status", "createdAt"]
    },
    "reseller_profit_releases": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["orderId", "resellerId", "vendorId", "createdAt"]
    },
    "reseller_profit_reviews": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["orderId", "resellerId", "reviewStatus", "submittedAt"]
    },
    "reseller_return_requests": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["orderId", "vendorId", "returnStatus", "createdAt"]
    },
    "reseller_profit_reversals": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["orderId", "resellerId", "vendorId", "status", "createdAt"]
    },
    "reseller_financial_idempotency": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["orderId", "transactionType", "createdAt"]
    },
    "order_status_logs": {
      ".read": "auth != null",
      ".write": true,
      ".indexOn": ["orderId", "timestamp"]
    },
    "order_courier_logs": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["orderId", "timestamp"]
    },
    "admin_notifications": {
      ".read": "auth != null && auth.token.admin === true",
      ".write": true
    },
    "vendor_notifications": {
      ".read": "auth != null",
      ".write": true
    },
    "vendor_wallet_transactions": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "courier_link_reviews": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["orderId", "vendorId", "status", "submittedAt"]
    },
    "referral_codes": {
      ".read": true,
      ".write": "auth != null"
    },
    "referrals": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "referral_stats": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "wallet_transactions": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["vendorId", "createdAt", "type", "status"]
    }
  }
}
